{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gplx.local/catalog.schema.json",
  "title": "CatalogBundleDto",
  "description": "Gói dữ liệu câu hỏi GPLX – dùng cho /sync/catalog, gói đóng kèm app và seed (xem plan/01_HopDong_API.md mục 1, 12).",
  "type": "object",
  "required": ["schemaVersion", "version", "sinceVersion", "generatedAt", "licenseClasses", "categories", "questions", "trafficSigns", "penalties"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "integer", "minimum": 0 },
    "sinceVersion": { "type": "integer", "minimum": 0 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "dataset": { "enum": ["sample", "official"] },
    "licenseClasses": { "type": "array", "items": { "$ref": "#/$defs/licenseClass" } },
    "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
    "trafficSigns": { "type": "array", "items": { "$ref": "#/$defs/trafficSign" } },
    "penalties": { "type": "array", "items": { "$ref": "#/$defs/penalty" } }
  },
  "$defs": {
    "objectId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
    "licenseCode": { "enum": ["A1", "A", "B"] },
    "categoryCode": { "enum": ["RULES", "CULTURE", "DRIVING", "MECHANICS", "SIGNS", "SITUATION"] },
    "status": { "enum": ["active", "hidden"] },
    "nullableString": { "type": ["string", "null"] },
    "category": {
      "type": "object", "required": ["code", "name", "order", "version"], "additionalProperties": false,
      "properties": { "code": { "$ref": "#/$defs/categoryCode" }, "name": { "type": "string", "minLength": 1 }, "order": { "type": "integer" }, "version": { "type": "integer" } }
    },
    "slot": {
      "type": "object", "required": ["label", "categoryCodes", "critical", "count"], "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "categoryCodes": { "type": "array", "items": { "$ref": "#/$defs/categoryCode" } },
        "critical": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "licenseClass": {
      "type": "object", "required": ["code", "name", "description", "order", "examConfig", "version"], "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/licenseCode" }, "name": { "type": "string" }, "description": { "type": "string" },
        "order": { "type": "integer" }, "version": { "type": "integer" },
        "examConfig": {
          "type": "object", "required": ["totalQuestions", "passScore", "durationMinutes", "slots"], "additionalProperties": false,
          "properties": {
            "totalQuestions": { "type": "integer", "minimum": 1 },
            "passScore": { "type": "integer", "minimum": 1 },
            "durationMinutes": { "type": "integer", "minimum": 1 },
            "slots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slot" } }
          }
        }
      }
    },
    "option": {
      "type": "object", "required": ["key", "text"], "additionalProperties": false,
      "properties": { "key": { "enum": ["1", "2", "3", "4"] }, "text": { "type": "string", "minLength": 1 } }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "number", "content", "searchText", "imageUrl", "imageHash", "options", "correctKey", "explanation", "legalRef", "categoryCode", "licenseClasses", "isCritical", "status", "version", "answerChangedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/objectId" },
        "number": { "type": "integer", "minimum": 1, "maximum": 600 },
        "content": { "type": "string", "minLength": 1 },
        "searchText": { "type": "string" },
        "imageUrl": { "$ref": "#/$defs/nullableString" },
        "imageHash": { "$ref": "#/$defs/nullableString" },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/option" } },
        "correctKey": { "enum": ["1", "2", "3", "4"] },
        "explanation": { "$ref": "#/$defs/nullableString" },
        "legalRef": { "$ref": "#/$defs/nullableString" },
        "categoryCode": { "$ref": "#/$defs/categoryCode" },
        "licenseClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/licenseCode" } },
        "isCritical": { "type": "boolean" },
        "status": { "$ref": "#/$defs/status" },
        "version": { "type": "integer" },
        "answerChangedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "trafficSign": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "code", "name", "group", "description", "imageUrl", "imageHash", "searchText", "status", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/objectId" }, "code": { "type": "string", "minLength": 1 }, "name": { "type": "string" },
        "group": { "enum": ["PROHIBITION", "DANGER", "MANDATORY", "INDICATION", "AUXILIARY", "OTHER"] },
        "description": { "type": "string" }, "imageUrl": { "$ref": "#/$defs/nullableString" }, "imageHash": { "$ref": "#/$defs/nullableString" },
        "searchText": { "type": "string" }, "status": { "$ref": "#/$defs/status" }, "version": { "type": "integer" }
      }
    },
    "penalty": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "violation", "vehicleType", "fineMin", "fineMax", "additionalPenalty", "legalRef", "searchText", "status", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/objectId" }, "violation": { "type": "string", "minLength": 1 },
        "vehicleType": { "enum": ["MOTORBIKE", "CAR"] },
        "fineMin": { "type": "integer", "minimum": 0 }, "fineMax": { "type": "integer", "minimum": 0 },
        "additionalPenalty": { "$ref": "#/$defs/nullableString" }, "legalRef": { "type": "string" },
        "searchText": { "type": "string" }, "status": { "$ref": "#/$defs/status" }, "version": { "type": "integer" }
      }
    }
  }
}
